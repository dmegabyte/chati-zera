// OpenCode V2 config. Запустите scripts/bootstrap.ps1 — он подставит {{CONFIG_DIR}}.
// MCP-серверы добавьте сами: opencode mcp add <name> --global --url <url>
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "fast-chati",
  "instructions": [
    "{{CONFIG_DIR}}/core-rules.md",
    "{{CONFIG_DIR}}/chati-style.md",
    "{{CONFIG_DIR}}/AGENTS.local.md"
  ],
  "experimental": {
    "todo": true
  },
  // Границы: секреты и служебные каталоги не читаем и не правим.
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "$HOME/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "$HOME/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "$HOME/.config/gh/*", "effect": "deny" },
    { "action": "read", "resource": "{{CONFIG_DIR}}/secrets/*", "effect": "deny" },
    { "action": "edit", "resource": "{{CONFIG_DIR}}/secrets/*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {}
  }
}
